# ── Store ──────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="Mom's"
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
NEXT_PUBLIC_SHIPPING_FLAT_CENTS=595
NEXT_PUBLIC_FREE_SHIPPING_OVER_CENTS=5000
LOW_STOCK_THRESHOLD=3

# ── Database (leave empty locally to use the built-in dev database) ──
# Neon: use the *pooled* connection string.
DATABASE_URL=

# ── Admin sign-in ──────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# First sign-in creates this owner account (only if no admin exists yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mom

# ── Payments (Stripe) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to true after turning on Stripe Tax in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX=false

# ── Photo storage (Vercel Blob; created automatically when you add Blob to the project) ──
BLOB_READ_WRITE_TOKEN=

# ── Rate limiting across all servers (Upstash Redis, free tier is plenty) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Alerts & email (all optional) ──────────────────────
# Slack or Discord incoming webhook for new orders, low stock and errors.
ALERT_WEBHOOK_URL=
# Resend: emails Mom on each order and customers when orders ship.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
EMAIL_FROM="Mom's <orders@your-domain.com>"
LOG_LEVEL=info
